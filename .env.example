# Copy to .env and fill in. Frontend devs can leave BACKEND=mock and ignore the rest.

# mock = canned data (no AI needed) | watsonx = real Granite calls
BACKEND=mock

# Only needed when BACKEND=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL=ibm/granite-3-8b-instruct

# Frontend
VITE_API_BASE=http://localhost:8000
