# Copy to .env and fill in. Frontend devs can leave BACKEND=mock and ignore the rest.

# mock = canned data (no AI needed) | watsonx = Granite calls | claude = Anthropic
BACKEND=watsonx

# Only needed when BACKEND=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
GRANITE_MODEL=ibm/granite-3-8b-instruct

# Only needed when BACKEND=claude. Claude drives the LLM stages; it has no
# embeddings API, so this backend embeds locally and uses the in-memory store.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Pinecone vector DB — required when BACKEND=watsonx
PINECONE_API_KEY=
PINECONE_INDEX=manuscript-characters
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_NAMESPACE=default

# Frontend
VITE_API_BASE=http://localhost:8000
